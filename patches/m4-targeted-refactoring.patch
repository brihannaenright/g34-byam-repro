+    public String callPythonScript(String scriptPath, Path prompt)
+            throws IOException, InterruptedException {
+        Process process = new ProcessBuilder(
+                "python3", scriptPath, prompt.toAbsolutePath().toString()
+        ).start();
+
+        try (var executor = java.util.concurrent.Executors.newVirtualThreadPerTaskExecutor()) {
+            var stdout = executor.submit(() ->
+                    new String(process.getInputStream().readAllBytes(),
+                            java.nio.charset.StandardCharsets.UTF_8));
+            var stderr = executor.submit(() ->
+                    new String(process.getErrorStream().readAllBytes(),
+                            java.nio.charset.StandardCharsets.UTF_8));
+
+            try {
+                int exitCode = process.waitFor();
+                String output = stdout.get();
+                String errors = stderr.get();
+
+                if (exitCode != 0) {
+                    throw new IOException("Python model call failed (exit code "
+                            + exitCode + "): " + errors.strip());
+                }
+                log.info("Python model script executed successfully.");
+                return output;
+            } catch (InterruptedException e) {
+                process.destroyForcibly();
+                Thread.currentThread().interrupt();
+                throw e;
+            } catch (java.util.concurrent.ExecutionException e) {
+                throw new IOException("Failed to read Python script output.", e.getCause());
